```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0,
               maximum-scale=1.0, user-scalable=no">

<title>For My Love ❤️</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    min-height: 100vh;
    min-height: 100dvh;

    display: flex;
    justify-content: center;
    align-items: center;

    background:
        linear-gradient(135deg,
        #ff416c,
        #ff4b8b,
        #8e44ad);

    font-family: Arial, sans-serif;

    color: white;

    overflow: hidden;
}


/* =========================
   CARD
========================= */

.card {

    width: calc(100% - 30px);
    max-width: 400px;

    padding: 32px 22px;

    text-align: center;

    background: rgba(255,255,255,0.15);

    border: 1px solid rgba(255,255,255,0.25);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    border-radius: 28px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.25);

    position: relative;

    z-index: 10;
}


/* =========================
   HEART
========================= */

.big-heart {

    font-size: 65px;

    margin-bottom: 12px;

    animation: heartbeat 1.2s infinite;
}

@keyframes heartbeat {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }
}


/* =========================
   TEXT
========================= */

h1 {

    font-size: 28px;

    margin-bottom: 15px;
}

.name {

    font-size: 35px;

    font-weight: bold;

    margin-bottom: 20px;
}

.message {

    font-size: 16px;

    line-height: 1.7;

    margin-bottom: 25px;
}


/* =========================
   BUTTON AREA
========================= */

.button-area {

    position: relative;

    width: 100%;

    height: 70px;

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 15px;
}


/* =========================
   BUTTONS
========================= */

button {

    border: none;

    outline: none;

    padding: 14px 27px;

    border-radius: 50px;

    font-size: 18px;

    font-weight: bold;

    font-family: Arial, sans-serif;

    touch-action: manipulation;

    user-select: none;

    -webkit-user-select: none;
}


/* YES */

#yesButton {

    background: white;

    color: #e84393;

    box-shadow:
        0 7px 20px rgba(0,0,0,0.25);

    z-index: 20;

    cursor: pointer;
}

#yesButton:active {

    transform: scale(0.92);
}


/* NO */

#noButton {

    background: rgba(255,255,255,0.22);

    color: white;

    position: relative;

    z-index: 30;

    transition:
        left 0.25s ease,
        top 0.25s ease;

    cursor: default;

    touch-action: none;
}


/* =========================
   SUCCESS SCREEN
========================= */

#success {

    display: none;
}

#success h1 {

    font-size: 31px;
}

.success-message {

    font-size: 17px;

    line-height: 1.8;

    margin-top: 20px;
}

.question {

    font-size: 25px;

    font-weight: bold;

    margin-top: 22px;

    line-height: 1.4;
}


/* =========================
   FLOATING HEARTS
========================= */

.floating-heart {

    position: fixed;

    bottom: -50px;

    pointer-events: none;

    z-index: 50;

    animation: floatHeart linear forwards;
}

@keyframes floatHeart {

    0% {

        transform:
            translateY(0)
            rotate(0deg);

        opacity: 0;
    }

    20% {

        opacity: 1;
    }

    100% {

        transform:
            translateY(-110vh)
            rotate(360deg);

        opacity: 0;
    }
}


/* =========================
   PHONE
========================= */

@media (max-width: 480px) {

    .card {

        padding: 30px 20px;

    }

    .big-heart {

        font-size: 60px;

    }

    h1 {

        font-size: 26px;

    }

    .name {

        font-size: 32px;

    }

    .message {

        font-size: 15.5px;

    }

    button {

        font-size: 17px;

        padding: 14px 24px;

    }
}

</style>
</head>


<body>


<!-- =================================
     FIRST SCREEN
================================= -->

<div class="card" id="proposalScreen">

    <div class="big-heart">
        ❤️
    </div>


    <h1>
        Hey My Love...
    </h1>


    <!-- CHANGE HER NAME -->
    <div class="name">
        [HER NAME] 💕
    </div>


    <p class="message">

        I don't know exactly when it happened...

        <br><br>

        But somewhere between our conversations,
        laughs and little moments,
        you became someone really special to me.

        <br><br>

        So today I want to ask you
        something from my heart. ❤️

    </p>


    <h1>
        Will You Be Mine? 💕
    </h1>


    <div class="button-area">

        <!-- ONLY THIS BUTTON WORKS -->

        <button id="yesButton">
            YES ❤️
        </button>


        <!-- THIS BUTTON ESCAPES -->

        <button id="noButton">
            NO 😜
        </button>

    </div>

</div>



<!-- =================================
     SUCCESS SCREEN
================================= -->

<div class="card" id="success">

    <div class="big-heart">
        🥹❤️
    </div>


    <h1>
        You Said YES! ❤️
    </h1>


    <p class="success-message">

        You just made my heart
        incredibly happy. 🥹❤️

        <br><br>

        I have one more thing
        to ask you...

    </p>


    <div class="question">

        Will You Be My Girlfriend? ❤️

    </div>


    <p class="success-message">

        I promise to make you smile,
        support you, annoy you a little 😜,
        and create lots of beautiful
        memories with you.

        <br><br>

        💕 🥰 💖 💗 💕

    </p>

</div>



<script>

/* =================================
   GET BUTTONS
================================= */

const yesButton =
    document.getElementById("yesButton");

const noButton =
    document.getElementById("noButton");

const proposalScreen =
    document.getElementById("proposalScreen");

const successScreen =
    document.getElementById("success");


/* =================================
   YES BUTTON
================================= */

/*
   Using CLICK instead of complicated
   mouse/touch events.

   This works on Android, iPhone
   and desktop browsers.
*/

yesButton.addEventListener("click", function () {

    proposalScreen.style.display = "none";

    successScreen.style.display = "block";

    createHearts();

});


/* =================================
   MOVE NO BUTTON
================================= */

function moveNoButton(event) {

    if (event) {

        event.preventDefault();

        event.stopPropagation();

    }


    /*
       Get screen dimensions
    */

    const screenWidth =
        window.innerWidth;

    const screenHeight =
        window.innerHeight;


    /*
       Button size
    */

    const buttonWidth =
        noButton.offsetWidth;

    const buttonHeight =
        noButton.offsetHeight;


    /*
       Generate safe random position

       Keep it away from screen edges.
    */

    const padding = 20;


    const maxX =
        screenWidth -
        buttonWidth -
        padding;


    const maxY =
        screenHeight -
        buttonHeight -
        padding;


    const randomX =
        Math.max(
            padding,
            Math.random() * maxX
        );


    const randomY =
        Math.max(
            padding,
            Math.random() * maxY
        );


    /*
       Use FIXED positioning.

       This is much more reliable
       on mobile.
    */

    noButton.style.position = "fixed";

    noButton.style.left =
        randomX + "px";

    noButton.style.top =
        randomY + "px";
}


/* =================================
   MOBILE TOUCH
================================= */

noButton.addEventListener(
    "touchstart",
    moveNoButton,
    { passive: false }
);


/* =================================
   DESKTOP MOUSE
================================= */

noButton.addEventListener(
    "mouseenter",
    moveNoButton
);


/* =================================
   EXTRA SAFETY

   If someone somehow clicks NO,
   move it instead of doing anything.
================================= */

noButton.addEventListener(
    "click",
    moveNoButton
);


/* =================================
   HEART CELEBRATION
================================= */

function createHearts() {

    const emojis = [
        "❤️",
        "💖",
        "💕",
        "💗",
        "💘",
        "🥰"
    ];


    for (let i = 0; i < 50; i++) {

        const heart =
            document.createElement("div");


        heart.className =
            "floating-heart";


        heart.innerHTML =
            emojis[
                Math.floor(
                    Math.random() *
                    emojis.length
                )
            ];


        heart.style.left =
            Math.random() * 100 + "vw";


        heart.style.fontSize =
            (18 + Math.random() * 25) +
            "px";


        heart.style.animationDuration =
            (3 + Math.random() * 4) +
            "s";


        document.body.appendChild(heart);


        setTimeout(function () {

            heart.remove();

        }, 7500);

    }

}

</script>

</body>
</html>
```
